rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Custom Claim concedido pelo backend à conta definida por ADMIN_UID.
    function isAdmin() {
      return false; // acesso privilegiado exclusivamente no backend
    }
    function acceptedTerms(userId) {
      return firestore.exists(/databases/(default)/documents/users/$(userId))
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.get('legal', {}).get('termsAccepted', false) == true
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.get('legal', {}).get('termsVersion', '') == '2026-09-16'
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.get('legal', {}).get('privacyVersion', '') == '2026-09-16'
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.get('legal', {}).get('communityRulesVersion', '') == '2026-09-16';
    }
    function canAct(userId) {
      return request.auth != null && request.auth.uid == userId
        && acceptedTerms(userId)
        && (!firestore.get(/databases/(default)/documents/users/$(userId)).data.keys().hasAny(['moderation'])
          || firestore.get(/databases/(default)/documents/users/$(userId)).data.moderation.status == 'active'
          || (firestore.get(/databases/(default)/documents/users/$(userId)).data.moderation.status == 'suspended'
            && firestore.get(/databases/(default)/documents/users/$(userId)).data.moderation.suspendedUntil <= request.time));
    }
    // New bytes are uploaded through the authenticated quarantine gateway.
    // Legacy public objects remain readable; private objects use the gateway.
    match /posts/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /profiles/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /chat/{userId}/{conversationId}/{fileName} {
      allow read, write: if false;
    }
    match /profile-review/{userId}/{fileName} {
      allow read, write: if false;
    }
    match /reports/{userId}/{reportId}/{fileName} {
      allow read, write: if false;
    }
  }
}
